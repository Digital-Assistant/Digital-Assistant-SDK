# Build-time configuration for @udan/digital-assistant-sdk.
#
# Local development: copy this file and fill in values.
#     cp environments/local.env.example environments/local.env
#
# CI: environments/<env>.env is generated from environment variables by
#     scripts/generate-env.mjs (see .github/workflows/ci.yml).
#
# This file is the key schema: scripts/generate-env.mjs and dotenv-webpack
# `safe` mode both require every KEY= line below to exist in <env>.env
# (empty values are allowed). Keep values here empty.
#
# NOTE: values referenced as process.env.* in src/ are inlined into the
# browser bundle at build time. Never put real secrets here — treat every
# value as public. See AGENTS.md section 8 (Security).

# --- API endpoints ---
# UDA backend base URL; the API is served under <baseURL>/api.
baseURL=
# Backend URL used for production hosts.
baseProdURL=
# Backend URL used for test hosts.
baseTestURL=
# Token and remote error-logging endpoint.
tokenUrl=

# --- Keycloak / auth ---
# Keycloak server base URL.
keycloakUrl=
# Keycloak realm name.
keycloakRealm=
# Keycloak client ID.
keycloakClientId=
# Keycloak client secret (secret — inlined into the bundle).
keycloakClientSecret=

# --- Profanity check ---
# Profanity-check service endpoint.
profanityUrl=
# Profanity-check service region.
profanityRegion=
# Profanity-check API key (secret — inlined into the bundle).
profanityKey=

# --- Translation ---
# Google Translate API endpoint.
googleTranslateUrl=
# Google Translate API key (secret — inlined into the bundle).
googleTranslateApiKey=

# --- Analytics ---
# Google Analytics measurement ID.
googleAnalyticsMeasurementId=
# Set to true to enable Google Analytics.
enableGoogleAnalytics=
# Google Analytics API secret (secret — inlined into the bundle).
googleAnalyticsSecretKey=

# --- LLM ---
# LLM search service base URL.
llmUrl=
