# Build-time configuration for @udan/digital-assistant-core.
#
# Local development: copy this file and fill in values.
#     cp environments/local.env.example environments/local.env
#
# CI: environments/<env>.env is generated from environment variables by
#     scripts/generate-env.mjs (see .github/workflows/ci.yml).
#
# NOTE: values referenced as process.env.* in src/ are inlined into the
# browser bundle at build time. Never put real secrets here — treat every
# value as public. See AGENTS.md section 8 (Security).

baseURL=
baseProdURL=
baseTestURL=
profanityKey=
profanityUrl=
profanityRegion=
googleTranslateUrl=
googleTranslateApiKey=
keyCloakUrl=
tokenUrl=
llmUrl=
keycloakRealm=
keycloakClientId=
keycloakClientSecret=
googleAnalyticsMeasurementId=
enableGoogleAnalytics=
googleAnalyticsSecretKey=
