# Build-time configuration for @udan/digital-assistant-sdk.
#
# Local development: copy this file and fill in values.
#     cp environments/local.env.example environments/local.env
#
# CI: environments/<env>.env is generated from environment variables by
#     scripts/generate-env.mjs (see .github/workflows/ci.yml).
#
# This file is the key schema: scripts/generate-env.mjs and dotenv-webpack
# `safe` mode both require every KEY= line below to exist in <env>.env
# (empty values are allowed). Keep values here empty, except the two
# log-level defaults at the end, which are safe public settings.
#
# Every value is inlined into the public browser bundle at build time, so this
# schema holds public keys only. Secret keys (Keycloak client secret, profanity,
# translate and analytics API keys) are not part of it and must never be added.
# scripts/ci/check-build-env.mjs fails the build if one has a value.
# See AGENTS.md section 8 (Security).
#
# URL defaults: one build serves TEST and PROD. The SDK picks the set at runtime
# from UDAGlobalConfig.environment ('PROD' when unset); a page can override each
# URL with UDAPluginSDK({ apiBaseUrl, tokenUrl, llmUrl, keycloakUrl }).
#
# Not in this schema (they never reach the bundle): BUILD_ENV, the input of
# scripts/generate-env.mjs and scripts/ci/check-build-env.mjs, set by the CI
# jobs; CI and GITHUB_ACTIONS, set by the CI platform; NODE_ENV, set by
# webpack's --mode and by Jest.

# --- Backend API (base URL including /api) ---
baseProdURL=
baseTestURL=

# --- Token service (token and remote error logging; trailing slash) ---
tokenProdUrl=
tokenTestUrl=

# --- LLM search (trailing slash) ---
llmProdUrl=
llmTestUrl=

# --- Keycloak server base URL ---
keycloakProdUrl=
keycloakTestUrl=

# Realm, client id and client secret have no build default: the page (or the extension) sets them.

# --- Profanity check (public endpoint settings) ---
profanityUrl=
profanityRegion=

# --- Translation (public endpoint) ---
googleTranslateUrl=

# --- Analytics ---
# legacy: nothing in src/ reads these two keys; the CI jobs still set them.
# Google Analytics measurement ID.
googleAnalyticsMeasurementId=
# Set to true to enable Google Analytics.
enableGoogleAnalytics=

# --- Logging (src/util/error/error-log.ts) ---
# Minimum console level, a Winston level name: error, warn, info, http,
# verbose, debug or silly. Not a number: an unknown name silences the console.
UDA_LOG_LEVEL=info
# Legacy numeric threshold: a message logs when its level number is at least
# this value (1 info, 2 warn, 3 debug, 4 verbose).
UDA_LOG_LEVELNumber=1
